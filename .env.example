# Database
DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (RS256)
# Generate keys: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#                openssl rsa -pubout -in private.pem -out public.pem
# Then base64-encode: base64 -w0 private.pem  (prepend "base64:" prefix)
# Or use escaped newlines: replace newlines with \n in the PEM string
JWT_PRIVATE_KEY=base64:<base64-encoded-private-key-pem>
JWT_PUBLIC_KEY=base64:<base64-encoded-public-key-pem>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP (Mailpit defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@scheduler.local

# App
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Default Tenant
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
