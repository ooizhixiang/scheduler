<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .container { max-width: 560px; margin: 0 auto; padding: 40px 20px; }
    .card { background: #ffffff; border-radius: 8px; padding: 32px; border: 1px solid #e4e4e7; }
    .logo { font-size: 20px; font-weight: 700; color: #18181b; margin-bottom: 24px; }
    h2 { margin: 0 0 12px; font-size: 18px; color: #18181b; }
    p { margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #3f3f46; }
    .btn { display: inline-block; padding: 10px 24px; background: #18181b; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 500; }
    .footer { margin-top: 24px; font-size: 12px; color: #a1a1aa; text-align: center; }
    .detail { background: #f4f4f5; border-radius: 6px; padding: 12px 16px; margin: 16px 0; font-size: 13px; color: #3f3f46; }
    .detail strong { color: #18181b; }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="logo">Scheduler</div>
      {{{content}}}
    </div>
    <div class="footer">
      <p>This email was sent by Scheduler. If you did not expect this email, you can safely ignore it.</p>
    </div>
  </div>
</body>
</html>
